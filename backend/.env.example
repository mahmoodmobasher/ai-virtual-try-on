TRYON_APP_NAME=AI Virtual Try-On
TRYON_ENVIRONMENT=local
TRYON_API_PREFIX=/api
TRYON_DATABASE_URL=sqlite+aiosqlite:///./tryon.db
TRYON_REDIS_URL=redis://localhost:6379/0
TRYON_TRYON_MODEL=tryondiffusion
TRYON_SEGMENTATION_MODEL=birefnet
TRYON_POSE_MODEL=openpifpaf
TRYON_LLM_STUDIO_BASE_URL=http://localhost:9997
TRYON_LLM_STUDIO_API_KEY=
TRYON_LLM_MODEL=gpt-oss-20b

# Clothes swap engine: local (CatVTON on this machine) or fashn (hosted API)
TRYON_GARMENT_SWAP_ENGINE=local
TRYON_LOCAL_TRYON_STEPS=30

# Only needed when TRYON_GARMENT_SWAP_ENGINE=fashn: https://app.fashn.ai/api
TRYON_FASHN_API_KEY=
TRYON_FASHN_MODEL=tryon-v1.6
TRYON_FASHN_MODE=quality

# When true (default), refuses to use any hosted/remote inference engine (e.g. FASHN)
# even if TRYON_GARMENT_SWAP_ENGINE is set to "fashn" by mistake. Images/video never
# leave this machine while this is true.
TRYON_ENFORCE_LOCAL_ONLY=true

# These are also set unconditionally in app/__init__.py so every ML dependency
# (transformers/diffusers/huggingface_hub) reads its models straight from the local
# cache with zero network calls, even for cache-metadata/version checks. Listed here
# for visibility; overriding them to disable offline mode is not recommended.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# HF_HUB_DISABLE_TELEMETRY=1
# NO_ALBUMENTATIONS_UPDATE=1
